<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.PdfDocCreate.Html2Pdf\CodeBrix.PdfDocCreate.Html2Pdf.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.PdfRasterizer\CodeBrix.PdfRasterizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CFF-outline test face lives with the PdfDocuments tests (as an embedded
         resource there); Html2PdfFonts.AddFontFile wants a FILE, so it is linked here
         and copied beside the tests. Test-only; see its NOTICE.txt beside it. -->
    <None Include="..\CodeBrix.PdfDocuments.Tests\SampleFiles\MathJax_AMS-Regular.otf"
          Link="SampleFiles\MathJax_AMS-Regular.otf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A package consumer receives the font-copy behaviour through the packed
    buildTransitive targets; a ProjectReference does not flow those, so the test
    project imports the same file directly and exercises the identical mechanism.
  -->
  <Import Project="..\..\src\CodeBrix.PdfDocCreate.Html2Pdf\buildTransitive\net10.0\CodeBrix.PdfDocCreate.Html2Pdf.MitLicenseForever.targets" />

</Project>
