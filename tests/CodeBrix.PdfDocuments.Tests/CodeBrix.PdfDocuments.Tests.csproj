<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />

  <ItemGroup>
    <None Remove="SampleFiles\Roboto-Regular.ttf" />
    <None Remove="SampleFiles\MathJax_AMS-Regular.otf" />
    <None Remove="SampleFiles\MathJax_AMS-CID.otf" />
    <None Remove="SampleFiles\MathJax_AMS-Encoded.otf" />
    <None Remove="SampleFiles\test-image-01.bmp" />
    <None Remove="SampleFiles\test-image-01.jpg" />
    <None Remove="SampleFiles\test-image-01.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SampleFiles\Roboto-Regular.ttf" />
    <!-- A CFF-outline face for the CFF subsetting tests; test-only, see SampleFiles\MathJax_AMS-Regular.NOTICE.txt -->
    <EmbeddedResource Include="SampleFiles\MathJax_AMS-Regular.otf" />
    <!-- The same face re-expressed as a CID-keyed CFF program by SampleFiles\make-mathjax-cid.py; test-only -->
    <EmbeddedResource Include="SampleFiles\MathJax_AMS-CID.otf" />
    <!-- The same face given a custom Encoding and a seac composite by SampleFiles\make-mathjax-encoded.py; test-only -->
    <EmbeddedResource Include="SampleFiles\MathJax_AMS-Encoded.otf" />
    <EmbeddedResource Include="SampleFiles\test-image-01.bmp" />
    <EmbeddedResource Include="SampleFiles\test-image-01.jpg" />
    <EmbeddedResource Include="SampleFiles\test-image-01.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.MarkupParse.MitLicenseForever" Version="1.0.238.561" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.PdfDocCreate\CodeBrix.PdfDocCreate.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.PdfDocuments\CodeBrix.PdfDocuments.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.PdfRasterizer\CodeBrix.PdfRasterizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\frog-and-toad.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
