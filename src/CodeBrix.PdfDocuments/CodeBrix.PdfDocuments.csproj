<Project Sdk="Microsoft.NET.Sdk" InitialTargets="SetVersionFromProductVersionInfo">

  <!-- Inline task to read version constants from ProductVersionInfo.cs at build time -->
  <UsingTask TaskName="ReadVersionFromSource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFilePath ParameterType="System.String" Required="true" />
      <VersionResult ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        var content = File.ReadAllText(SourceFilePath);
        var major = Regex.Match(content, @"VersionMajor\s*=\s*""(\d+)""").Groups[1].Value;
        var minor = Regex.Match(content, @"VersionMinor\s*=\s*""(\d+)""").Groups[1].Value;
        var build = Regex.Match(content, @"VersionBuild\s*=\s*""(\d+)""").Groups[1].Value;
        VersionResult = $"{major}.{minor}.{build}";
      </Code>
    </Task>
  </UsingTask>

  <Target Name="SetVersionFromProductVersionInfo">
    <ReadVersionFromSource SourceFilePath="$(MSBuildProjectDirectory)\ProductVersionInfo.cs">
      <Output TaskParameter="VersionResult" PropertyName="Version" />
      <Output TaskParameter="VersionResult" PropertyName="PackageVersion" />
      <Output TaskParameter="VersionResult" PropertyName="AssemblyVersion" />
      <Output TaskParameter="VersionResult" PropertyName="FileVersion" />
    </ReadVersionFromSource>
    <Message Importance="high" Text="Version read from ProductVersionInfo.cs: $(Version)" />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet Package Properties -->
    <PackageId>CodeBrix.PdfDocuments.MitLicenseForever</PackageId>
    <!--<Version>value generated via VersionResult from ProductVersionInfo.cs above</Version>-->
    <Authors>Jeremy Ellis</Authors>
    <Product>CodeBrix.PdfDocuments</Product>
    <Title>CodeBrix.PdfDocuments</Title>
    <Description>CodeBrix.PdfDocuments is an Open Source .NET 10 (and higher) library that easily creates and processes PDF documents. The same drawing routines can be used to create PDF documents, draw on the screen, or send output to any printer.</Description>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.PdfDocuments</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.PdfDocuments</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>PdfDocuments;PDF;document;creation;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Messages.de.restext" />
    <None Remove="Resources\Messages.restext" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Messages.de.restext" />
    <EmbeddedResource Include="Resources\Messages.restext" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Compression.MitLicenseForever" Version="1.0.49" />
    <PackageReference Include="CodeBrix.Imaging.ApacheLicenseForever" Version="1.0.72" />
  </ItemGroup>

</Project>
