<Project>
  <!--
    Delivers the font files shipped by the CodeBrix.Platform.Fonts.* packages into the
    consuming application's build output.

    The font packages (CodeBrix.Platform.Fonts.Roboto / .Merriweather / .RobotoMono) pack
    their .ttf and .ttf.manifest files under lib/net10.0/<PackageName>/Fonts/ inside the
    nupkg. In a CodeBrix.Platform application the platform asset pipeline copies those
    files into the app; in a plain .NET application nothing does - NuGet only copies the
    package assemblies. This target closes that gap so the Html2Pdf font resolver can
    always discover fonts at:

        <application base directory>/CodeBrix.Platform.Fonts.<Name>/Fonts/

    which is the same layout a CodeBrix.Platform application uses.

    How it works: every CodeBrix.Platform.Fonts.* package ships an assembly that IS
    copied local, so it appears in @(RuntimeCopyLocalItems) with its full path inside
    the resolved package folder. The font files live in a folder named after that
    assembly, next to it. Globbing relative to the assembly path therefore finds the
    exact restored version of each font package, wherever the package cache lives.

    Opt out (for example when a CodeBrix.Platform app's own asset pipeline already
    delivers the fonts and the duplicate copy is unwanted) by setting:

        <CodeBrixHtml2PdfDisableFontCopy>true</CodeBrixHtml2PdfDisableFontCopy>
  -->
  <Target Name="_CodeBrixHtml2PdfCollectPackageFonts"
          AfterTargets="ResolveReferences"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(CodeBrixHtml2PdfDisableFontCopy)' != 'true'">
    <ItemGroup>
      <_CodeBrixHtml2PdfFontAssembly
          Include="@(RuntimeCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('CodeBrix.Platform.Fonts.'))" />
    </ItemGroup>
    <ItemGroup>
      <_CodeBrixHtml2PdfFontFile
          Include="%(_CodeBrixHtml2PdfFontAssembly.RootDir)%(_CodeBrixHtml2PdfFontAssembly.Directory)%(_CodeBrixHtml2PdfFontAssembly.Filename)\Fonts\*.ttf*">
        <FontPackageFolder>%(_CodeBrixHtml2PdfFontAssembly.Filename)</FontPackageFolder>
      </_CodeBrixHtml2PdfFontFile>
    </ItemGroup>
    <ItemGroup>
      <None Include="@(_CodeBrixHtml2PdfFontFile)"
            Condition="'@(_CodeBrixHtml2PdfFontFile)' != ''"
            Link="%(_CodeBrixHtml2PdfFontFile.FontPackageFolder)\Fonts\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
